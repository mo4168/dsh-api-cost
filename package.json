{
  "name": "dsh-api-cost",
  "version": "1.0.0",
  "type": "module",
  "description": "Local API spend meter for DeepSeek Harness: folds real session token usage, prices it with an editable table (relay sub-API friendly), and shows today / 7d / 30d / total cost under the composer.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "api-cost",
    "token-usage",
    "billing",
    "relay"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mo4168/dsh-api-cost.git"
  },
  "homepage": "https://github.com/mo4168/dsh-api-cost#readme",
  "bugs": {
    "url": "https://github.com/mo4168/dsh-api-cost/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node scripts/check-bundle-name.mjs"
  },
  "engines": {
    "dsh": ">=0.1.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "scripts/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
